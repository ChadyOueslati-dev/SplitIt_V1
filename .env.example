# Copy to .env before running locally.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/splitit
JWT_SECRET=replace-this-with-a-long-random-string

# SMTP, for the "forgot password" email code. Required for that one feature only —
# everything else works without it. A Gmail account with an app password (not your
# normal password: https://myaccount.google.com/apppasswords) is the quickest way to
# test this; any SMTP provider (SendGrid, Mailgun, your own mail server) works too.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM=SplitIt <you@gmail.com>
